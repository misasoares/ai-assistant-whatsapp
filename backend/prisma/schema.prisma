generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Customer {
  id    String @id @default(uuid())
  name  String // Nome da empresa ou do cliente
  email String @unique
  plan  String @default("FREE") // Para controle de limites de instâncias

  // Relacionamento: Um cliente tem muitas instâncias
  instances Instance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

model Instance {
  id   String @id @default(uuid())
  name String @unique // Nome identificador na Evolution (ex: "cliente1-vendas")

  // Relacionamento com Customer
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  evolutionKey String?
  status       String  @default("DISCONNECTED")

  // Relacionamento com Dados Vetorizados (Conhecimento da IA desta instância)
  embeddings DocumentEmbedding[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("instances")
}

model DocumentEmbedding {
  id         String                       @id @default(uuid())
  instanceId String
  instance   Instance                     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  content    String
  vector     Unsupported("vector(1536)")?
  metadata   Json?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@map("document_embeddings")
}
